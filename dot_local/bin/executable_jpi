#!/usr/bin/env bash
set -euo pipefail

# Delegate runtime setup while preserving the caller's working directory.
launcher="$HOME/git/pi-mono/pi-test.sh"
if [[ ! -f "$launcher" ]]; then
  printf 'jpi: missing development launcher: %s; restore the Pi development checkout.\n' "$launcher" >&2
  exit 1
fi

exec bash "$launcher" "$@"
