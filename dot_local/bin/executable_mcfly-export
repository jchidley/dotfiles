#!/bin/bash
# Export and encrypt McFly database for chezmoi

set -euo pipefail

get_chezmoi_dir() {
    if command -v chezmoi >/dev/null 2>&1; then
        local dir
        dir="$(chezmoi source-path 2>/dev/null || true)"
        if [ -n "$dir" ]; then
            echo "$dir"
            return
        fi
    fi
    echo "$HOME/.local/share/chezmoi"
}

get_password() {
    local pw=""
    if command -v ak >/dev/null 2>&1; then
        pw="$(ak get mcfly-backup 2>/dev/null || true)"
    fi

    if [ -z "$pw" ]; then
        read -r -s -p "McFly backup passphrase (store later with 'ak set mcfly-backup'): " pw
        echo >&2
    fi

    printf '%s' "$pw"
}

MCFLY_DB="${MCFLY_DB:-$HOME/.local/share/mcfly/history.db}"
CHEZMOI_DIR="$(get_chezmoi_dir)"

# Machine identifier - unique per instance
MACHINE_TAG="$(hostname)_$(cat /etc/machine-id 2>/dev/null | head -c 8 || echo "unknown")"
EXPORT_DIR="${MCFLY_BACKUP_DIR:-$CHEZMOI_DIR/mcfly_backups}"
EXPORT_FILE="$EXPORT_DIR/encrypted_mcfly_${MACHINE_TAG}.db.gpg"

echo "Machine: $MACHINE_TAG"

command -v gpg >/dev/null 2>&1 || { echo "gpg is required"; exit 1; }

# Check if database exists
[ ! -f "$MCFLY_DB" ] && { echo "McFly database not found at $MCFLY_DB"; exit 1; }

# Create directory
mkdir -p "$(dirname "$EXPORT_FILE")"

# Get password
echo "Getting password from ak..."
PASSWORD="$(get_password)"

# Encrypt without exposing the passphrase in the process argument list.
echo "Encrypting..."
printf '%s' "$PASSWORD" | gpg --batch --yes --pinentry-mode loopback --passphrase-fd 0 \
    --cipher-algo AES256 --symmetric --armor \
    --output "$EXPORT_FILE" "$MCFLY_DB"
unset PASSWORD

echo "✓ Encrypted: $(basename "$EXPORT_FILE")"
echo "  Commit this file to your repository"
