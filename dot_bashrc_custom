# Start top-level home shells in the scratch directory, but preserve a working
# directory deliberately selected by tools such as `chezmoi cd`, tmux, or SSH.
scratch="$HOME/tmp"
[[ -d "$scratch" ]] || mkdir -p "$scratch"
if [[ "$PWD" == "$HOME" ]]; then
  cd "$scratch"
fi
