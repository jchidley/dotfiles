# fnm (resolve path relative to current user)
if [ -n "$XDG_DATA_HOME" ] && [ -x "$XDG_DATA_HOME/fnm/fnm" ]; then
  FNM_PATH="$XDG_DATA_HOME/fnm"
elif [ -x "$HOME/.local/share/fnm/fnm" ]; then
  FNM_PATH="$HOME/.local/share/fnm"
