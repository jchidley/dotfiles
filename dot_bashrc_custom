if command -v hx >/dev/null 2>&1; then
  export SUDO_EDITOR="hx"
  export VISUAL="hx"
  export EDITOR="hx"
else
  export SUDO_EDITOR="nano"
  export VISUAL="nano"
  export EDITOR="nano"
fi

# bat theme
export BAT_THEME="gruvbox-dark"

# Resolve helpers from the platform's source checkout. Pi discovers the same
# resources through its package manifest; no duplicate skill link is required.
_windows_env_dir="$HOME/git/agent-skills/skills/windows-env"
[[ -f "$_windows_env_dir/SKILL.md" ]] || _windows_env_dir=""

# WSL2: use win-open as BROWSER so OAuth callbacks work (xdg-open doesn't).
if [[ -x "$_windows_env_dir/win-open" ]]; then
  export BROWSER="$_windows_env_dir/win-open"
fi

[ -t 1 ] && [ -f "$HOME/bash_shell_hints" ] && cat "$HOME/bash_shell_hints"
# echo zoxide path cd'd to 
export _ZO_ECHO=1

path_prepend "$HOME/bin"
path_prepend "$HOME/.local/bin"
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) export PATH="$HOME/.local/share/mise/shims${PATH:+:$PATH}" ;;
esac
path_prepend "$HOME/.amp/bin"
path_prepend "/usr/local/go/bin"
# windows-env helpers are loaded by skill or called through explicit aliases;
# do not expose generic helper names globally merely for Pi discovery.
# see https://github.com/neovim/neovim/blob/master/INSTALL.md#install-from-package
path_append "/opt/nvim-linux-x86_64/bin"

# API Keys Manager (ak) is installed in ~/.local/bin. Do not source its legacy
# bulk-loading functions or place decrypted secrets in shell startup state.
# SSH passphrases are askpass-only credentials, never shell environment data.
unset SSH_KEY_PASSPHRASE

# GPG agent (for ak/GPG encryption, 20h cache)
[ -t 0 ] && export GPG_TTY="$(tty)"
[ -t 0 ] && gpgconf --launch gpg-agent 2>/dev/null

# direnv loads only the reviewed service allowlist in ~/.envrc. A bare
# no-argument bulk load is rejected, and export:false credentials stay out.

# OpenSSH keys remain in OpenSSH's agent, while ak decrypts their passphrase
# through the same 20h gpg-agent cache used by API secrets. Start/reuse the
# agent now; the askpass helper performs the explicit `ak get ssh-key` below.
if [[ -n ${WSL_DISTRO_NAME:-} && -r "$HOME/.local/lib/credential-agent.sh" ]]; then
  source "$HOME/.local/lib/credential-agent.sh"
  credential_agent_start
fi

# Pico SDK paths - only export if directories exist
[ -d "$HOME/pico/pico-sdk" ] && export PICO_SDK_PATH="$HOME/pico/pico-sdk"
[ -d "$HOME/pico/pico-examples" ] && export PICO_EXAMPLES_PATH="$HOME/pico/pico-examples"
[ -d "$HOME/pico/pico-extras" ] && export PICO_EXTRAS_PATH="$HOME/pico/pico-extras"
[ -d "$HOME/pico/pico-playground" ] && export PICO_PLAYGROUND_PATH="$HOME/pico/pico-playground"


# https://github.com/ajeetdsouza/zoxide?tab=readme-ov-file#configuration
[ -t 1 ] && command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init bash)"

# direnv
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook bash)"

# McFly records every completed command in SQLite and appends it promptly to
# the ordinary HISTFILE. Its database can contain secrets typed as commands.
_mcfly_data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/mcfly"
mkdir -p "$_mcfly_data_dir"
chmod 700 "$_mcfly_data_dir" 2>/dev/null || true
[ ! -f "$_mcfly_data_dir/history.db" ] || chmod 600 "$_mcfly_data_dir/history.db" 2>/dev/null || true
unset _mcfly_data_dir

# Fall back to an equivalent per-prompt file flush when McFly is unavailable,
# so a crashed shell loses at most its current command.
export MCFLY_RESULTS=60
if [ -t 1 ] && command -v mcfly >/dev/null 2>&1; then
  eval "$(mcfly init bash)"
  # McFly defaults an empty HISTCONTROL to ignorespace; restore full capture.
  HISTCONTROL=
  HISTIGNORE=
else
  _history_sync() {
    local previous_status=$?
    history -a
    history -n
    return "$previous_status"
  }
  if [[ $(declare -p PROMPT_COMMAND 2>/dev/null) == "declare -a"* ]]; then
    PROMPT_COMMAND+=("_history_sync")
  elif [[ ";${PROMPT_COMMAND:-};" != *";_history_sync;"* ]]; then
    PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND;}_history_sync"
  fi
fi


# API Keys - GPG-based management (see the platform's ~/git/ak checkout)
#
# Quick usage:
#   ak list              # Show service metadata without decrypting values
#   ak get <service>     # Explicitly decrypt one required service
#   ak set <service>     # Store a secret (prompts for value)
#   export OPENROUTER_API_KEY="$(ak get openrouter)"   # One-off shell export
#
# Never run `ak export` from shell startup or direnv. Services marked
# `export: false`, including ssh-key, cannot be exported at all.
# GPG agent caches the passphrase (~20h TTL, see ~/.gnupg/gpg-agent.conf).
# Lock immediately: gpgconf --kill gpg-agent

# Askpass explicitly retrieves only ssh-key; the passphrase never enters this
# shell's environment, and ssh-agent enforces the matching 20h key lifetime.
if [[ -n ${WSL_DISTRO_NAME:-} && $- == *i* ]] && declare -F credential_agent_load_ssh_key >/dev/null; then
    credential_agent_load_ssh_key || true
fi

