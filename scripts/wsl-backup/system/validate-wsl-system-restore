#!/usr/bin/env bash
set -euo pipefail

fail() { printf 'system-restore-validation: %s\n' "$*" >&2; exit 1; }
[[ $# -eq 1 ]] || fail 'usage: validate-wsl-system-restore EXTRACTED_ROOT'
root=$(realpath -e -- "$1")
[[ $root != / && -d $root ]] || fail 'validation root must be an existing isolated directory'

for path in \
  etc/os-release \
  usr/local/sbin/backup-wsl-home \
  usr/local/sbin/wsl-home-scheduler \
  etc/systemd/system/wsl-home-scheduler.service \
  etc/systemd/system/wsl-home-scheduler.timer; do
  [[ -e $root/$path ]] || fail "required system path is absent: /$path"
done
for path in home/jack var/lib/restic/home etc/restic/home.password; do
  [[ ! -e $root/$path ]] || fail "separated payload was restored from the system archive: /$path"
done
[[ $(stat -c %u:%g "$root/etc") == 0:0 ]] || fail '/etc ownership was not preserved'
[[ $(stat -c %a "$root/usr/local/sbin/backup-wsl-home") == 755 ]] || fail 'backup command mode was not preserved'
[[ -L $root/etc/mtab ]] || fail '/etc/mtab symlink was not preserved'
[[ $(readlink "$root/etc/mtab") == /proc/mounts ]] || fail '/etc/mtab target is unexpected'
printf 'system_restore_validation=passed metadata=ownership,mode,symlink separated_home=true\n'
