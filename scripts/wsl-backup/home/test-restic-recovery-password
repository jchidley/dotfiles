#!/usr/bin/env bash
set -euo pipefail

CONFIG=${RESTIC_HOME_CONFIG:-/etc/restic/home.conf}

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

[[ $EUID -eq 0 ]] || fail "run with sudo so the repository is readable"
[[ -t 0 && -t 2 ]] || fail "an interactive terminal is required"
[[ -f "$CONFIG" && -r "$CONFIG" ]] || fail "configuration is not readable: $CONFIG"
[[ $(stat -c %u "$CONFIG") == 0 ]] || fail "configuration must be root-owned"
config_mode=$(stat -c %a "$CONFIG")
(( (8#$config_mode & 8#022) == 0 )) || fail "configuration must not be group/world-writable"
# shellcheck source=/dev/null
source "$CONFIG"
REPOSITORY=${RESTIC_REPOSITORY:?missing RESTIC_REPOSITORY in configuration}
EXPECTED_REPOSITORY_ID=${EXPECTED_REPOSITORY_ID:?missing EXPECTED_REPOSITORY_ID in configuration}
[[ $EXPECTED_REPOSITORY_ID =~ ^[0-9a-f]{64}$ ]] || fail "expected repository ID is invalid"
[[ -d "$REPOSITORY" && -f "$REPOSITORY/config" ]] ||
  fail "existing repository is absent or uninitialized: $REPOSITORY"
command -v restic >/dev/null 2>&1 || fail "restic is not installed"
command -v jq >/dev/null 2>&1 || fail "jq is not installed"

# Do not permit Restic to fall back to the installed runtime credential.
unset RESTIC_PASSWORD RESTIC_PASSWORD_FILE RESTIC_PASSWORD_COMMAND
set +x
recovery_password=''
printf 'Enter the independently retrieved Restic recovery password: ' >&2
IFS= read -r -s recovery_password
printf '\n' >&2
[[ -n "$recovery_password" ]] || fail "no password was entered"

# A here-string supplies a private inherited file descriptor. The password is
# not placed in argv, the environment, a filesystem file, or command output.
config=$(restic --repo "$REPOSITORY" --password-file /dev/fd/3 cat config \
  3<<<"$recovery_password" 2>/dev/null) || {
  recovery_password=''
  unset recovery_password
  fail "the supplied recovery password did not unlock the existing repository"
}
recovery_password=''
unset recovery_password
actual_id=$(jq -er '.id' <<<"$config") || fail "repository configuration is invalid"
[[ $actual_id == "$EXPECTED_REPOSITORY_ID" ]] ||
  fail "repository identity mismatch: got $actual_id, expected $EXPECTED_REPOSITORY_ID"
printf 'recovery_password_test=passed repository=%s repository_id=%s\n' \
  "$REPOSITORY" "$actual_id"
