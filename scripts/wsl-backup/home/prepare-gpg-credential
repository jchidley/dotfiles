#!/usr/bin/env bash
# Approved one-time enrollment only. Never prints or persistently stages plaintext.
set -euo pipefail
set +x
fail() { printf 'prepare-gpg-credential: %s\n' "$*" >&2; exit 1; }
[[ $EUID -eq 0 && $# -eq 0 ]] || fail 'run as root without arguments after owner approval'
source_file=/etc/restic/home.password
target=/home/jack/.config/restic/home.password.gpg
[[ -f $source_file && ! -L $source_file && $(stat -c %u:%a "$source_file") == 0:600 ]] || fail 'expected root-owned mode-600 runtime password file'
[[ ! -e $target && ! -L $target ]] || fail 'encrypted credential already exists; inspect rather than overwrite'
# Public recipient selection only; do not copy or change the existing keyring.
selector=$(< /home/jack/git/ak/.gpg-key-id)
[[ $selector =~ ^([0-9A-Fa-f]{8}|[0-9A-Fa-f]{16}|[0-9A-Fa-f]{40}|[0-9A-Fa-f]{64})$ ]] || fail 'expected an existing hexadecimal GPG key selection'
recipient=$(/usr/sbin/runuser -u jack -- /usr/bin/env -i HOME=/home/jack GNUPGHOME=/home/jack/.gnupg PATH=/usr/bin:/bin \
  /usr/bin/gpg --batch --no-tty --with-colons --list-keys "$selector" |
  awk -F: '$1=="pub" { n++; primary=1 } $1=="fpr" && primary { fingerprint=$10; primary=0 }
    END { if(n!=1) exit 1; print fingerprint }') || fail 'existing key selection is absent or ambiguous'
[[ $recipient =~ ^([0-9A-Fa-f]{40}|[0-9A-Fa-f]{64})$ ]] || fail 'resolved fingerprint is malformed'
/usr/sbin/runuser -u jack -- /usr/bin/install -d -m 700 /home/jack/.config/restic
# Only the root shell opens the source. The user GPG process receives its stdin;
# no password enters argv, the environment, logs, or a new plaintext file.
/usr/sbin/runuser -u jack -- /usr/bin/env -i HOME=/home/jack GNUPGHOME=/home/jack/.gnupg PATH=/usr/bin:/bin \
  /usr/bin/gpg --batch --no-tty --trust-model always --recipient "$recipient" \
  --encrypt --output "$target" < "$source_file"
/usr/sbin/runuser -u jack -- /usr/bin/chmod 600 "$target"
[[ -s $target && ! -L $target && $(stat -c %U:%a "$target") == jack:600 ]] || fail 'encrypted credential metadata failed validation; preserve for inspection'
printf 'encrypted_credential_prepared=true plaintext_source_preserved=true deployment_performed=false\n'
