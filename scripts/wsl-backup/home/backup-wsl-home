#!/usr/bin/env bash
set -euo pipefail

CONFIG=${RESTIC_HOME_CONFIG:-/etc/restic/home.conf}
COMMAND=${1:-help}
LOCK_FILE=/run/lock/restic-home.lock

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

[[ $EUID -eq 0 ]] || fail "run as root"
[[ -r "$CONFIG" ]] || fail "configuration is not readable: $CONFIG"
# Never inherit a plaintext credential or silently fall back to one.
unset RESTIC_PASSWORD RESTIC_PASSWORD_FILE RESTIC_PASSWORD_COMMAND
# shellcheck source=/dev/null
source "$CONFIG"

required_vars=(
  SOURCE RESTIC_REPOSITORY EXPECTED_REPOSITORY_ID RESTIC_PASSWORD_COMMAND
  RECOVERY_CONFIRMATION_FILE LOG_DIR LOG_RETENTION_DAYS STAGING_DIR RESTIC_CACHE_DIR
  INCIDENT_HOLD_FILE SOURCE_BASELINE_FILE BACKUP_HOST EXPECTED_UID EXPECTED_GID
  MIN_BYTES MIN_FILES MIN_SESSIONS MIN_BASELINE_BYTES_PERCENT
  MIN_BASELINE_FILES_PERCENT MIN_BASELINE_SESSIONS_PERCENT
  MAX_SNAPSHOT_AGE_SECONDS MCFLY_DATABASE MCFLY_RECOVERY_COPY
)
for name in "${required_vars[@]}"; do
  [[ -n ${!name:-} ]] || fail "missing configuration value: $name"
done

umask 077
[[ -z ${RESTIC_PASSWORD_FILE+x} && -z ${RESTIC_PASSWORD+x} ]] || fail 'plaintext password configuration is unsupported'
export RESTIC_REPOSITORY RESTIC_PASSWORD_COMMAND RESTIC_CACHE_DIR

ensure_runtime() {
  install -d -m 700 "$LOG_DIR" "$STAGING_DIR" "$RESTIC_CACHE_DIR" "$(dirname "$LOCK_FILE")"
  if [[ $CONFIG == /etc/restic/home.conf ]]; then
    [[ $RESTIC_PASSWORD_COMMAND == /usr/local/sbin/restic-home-password ]] || fail 'unexpected production password provider'
    [[ -x $RESTIC_PASSWORD_COMMAND && $(stat -c %u:%a "$RESTIC_PASSWORD_COMMAND") == 0:755 ]] ||
      fail 'password provider must be executable, root-owned mode 755'
  fi
  if [[ ! -f "$RECOVERY_CONFIRMATION_FILE" ]]; then
    printf 'WARNING: Bitwarden recovery-password confirmation is absent: %s\n' \
      "$RECOVERY_CONFIRMATION_FILE" >&2
  fi
}

start_log() {
  local operation=$1 log
  find "$LOG_DIR" -maxdepth 1 -type f -name '*.log' -mtime "+$LOG_RETENTION_DAYS" -delete
  log="$LOG_DIR/$(date -u +%Y%m%dT%H%M%SZ)-${operation}.log"
  exec > >(tee -a "$log") 2>&1
  printf 'started=%s operation=%s host=%s repository=%s\n' \
    "$(date --iso-8601=seconds)" "$operation" "$BACKUP_HOST" "$RESTIC_REPOSITORY"
}

acquire_lock() {
  exec 9>"$LOCK_FILE"
  if ! flock -n 9; then
    printf 'Another Restic home operation owns %s\n' "$LOCK_FILE" >&2
    exit 75
  fi
}

measure_source() {
  local src=${1:-$SOURCE} uid gid mode landmark
  SOURCE_ERROR=''
  if [[ ! -d "$src" ]]; then SOURCE_ERROR="source directory does not exist: $src"; return 1; fi
  uid=$(stat -c %u "$src") || { SOURCE_ERROR='could not measure source UID'; return 1; }
  gid=$(stat -c %g "$src") || { SOURCE_ERROR='could not measure source GID'; return 1; }
  if [[ $uid != "$EXPECTED_UID" || $gid != "$EXPECTED_GID" ]]; then
    SOURCE_ERROR="source owner is $uid:$gid, expected $EXPECTED_UID:$EXPECTED_GID"; return 1
  fi

  SOURCE_BYTES=$(du -sbx "$src" | awk '{print $1}') || { SOURCE_ERROR='could not measure source bytes'; return 1; }
  SOURCE_FILES=$(find "$src" -xdev -type f -printf '.\n' | wc -l) || { SOURCE_ERROR='could not count source files'; return 1; }
  [[ $SOURCE_BYTES =~ ^[0-9]+$ && $SOURCE_FILES =~ ^[0-9]+$ ]] || { SOURCE_ERROR='invalid source measurements'; return 1; }
  if [[ $SOURCE_BYTES -lt $MIN_BYTES ]]; then SOURCE_ERROR="source has only $SOURCE_BYTES bytes; minimum is $MIN_BYTES"; return 1; fi
  if [[ $SOURCE_FILES -lt $MIN_FILES ]]; then SOURCE_ERROR="source has only $SOURCE_FILES files; minimum is $MIN_FILES"; return 1; fi

  for landmark in "${REQUIRED_LANDMARKS[@]}"; do
    if [[ ! -e "$src/$landmark" ]]; then SOURCE_ERROR="required source landmark is missing: $landmark"; return 1; fi
  done

  SOURCE_SESSIONS=$(find "$src/.pi/agent/sessions" -type f -printf '.\n' | wc -l) || { SOURCE_ERROR='could not count source sessions'; return 1; }
  [[ $SOURCE_SESSIONS =~ ^[0-9]+$ ]] || { SOURCE_ERROR='invalid session count'; return 1; }
  if [[ $SOURCE_SESSIONS -lt $MIN_SESSIONS ]]; then SOURCE_ERROR="source has only $SOURCE_SESSIONS Pi sessions; minimum is $MIN_SESSIONS"; return 1; fi

  mode=$(stat -c %a "$src/.ssh/id_ed25519") || { SOURCE_ERROR='could not measure SSH key mode'; return 1; }
  if [[ $mode != 600 ]]; then SOURCE_ERROR=".ssh/id_ed25519 mode is $mode, expected 600"; return 1; fi

  if [[ $(sqlite3 "$src/$MCFLY_DATABASE" 'PRAGMA integrity_check;') != ok ]]; then
    SOURCE_ERROR='McFly database integrity check failed'; return 1
  fi

  printf 'source_valid bytes=%s files=%s sessions=%s uid=%s gid=%s\n' \
    "$SOURCE_BYTES" "$SOURCE_FILES" "$SOURCE_SESSIONS" "$uid" "$gid"
}

read_baseline() {
  local -a lines
  [[ -f "$SOURCE_BASELINE_FILE" ]] || return 1
  mapfile -t lines < "$SOURCE_BASELINE_FILE"
  [[ ${#lines[@]} -eq 5 && ${lines[0]} == schema_version=1 &&
      ${lines[1]} == "source=$SOURCE" && ${lines[2]} =~ ^bytes=([0-9]+)$ ]] || return 1
  BASELINE_BYTES=${BASH_REMATCH[1]}
  [[ ${lines[3]} =~ ^files=([0-9]+)$ ]] || return 1
  BASELINE_FILES=${BASH_REMATCH[1]}
  [[ ${lines[4]} =~ ^sessions=([0-9]+)$ ]] || return 1
  BASELINE_SESSIONS=${BASH_REMATCH[1]}
  ((BASELINE_BYTES > 0 && BASELINE_FILES > 0 && BASELINE_SESSIONS > 0))
}

set_incident_hold() {
  local reason=$1 temporary
  install -d -m 700 "$(dirname "$INCIDENT_HOLD_FILE")"
  temporary=$(mktemp "${INCIDENT_HOLD_FILE}.tmp.XXXXXX")
  printf 'schema_version=1\ncreated=%s\nreason=%s\n' \
    "$(date --iso-8601=seconds)" "$reason" > "$temporary"
  chmod 600 "$temporary"
  mv -f "$temporary" "$INCIDENT_HOLD_FILE"
}

validate_against_baseline() {
  local reason=''
  if ! read_baseline; then
    set_incident_hold 'source baseline is missing or malformed'
    fail "source baseline is missing or malformed; retention hold created"
  fi
  ((SOURCE_BYTES * 100 >= BASELINE_BYTES * MIN_BASELINE_BYTES_PERCENT)) || reason="bytes $SOURCE_BYTES below ${MIN_BASELINE_BYTES_PERCENT}% of baseline $BASELINE_BYTES"
  ((SOURCE_FILES * 100 >= BASELINE_FILES * MIN_BASELINE_FILES_PERCENT)) || reason="files $SOURCE_FILES below ${MIN_BASELINE_FILES_PERCENT}% of baseline $BASELINE_FILES"
  ((SOURCE_SESSIONS * 100 >= BASELINE_SESSIONS * MIN_BASELINE_SESSIONS_PERCENT)) || reason="sessions $SOURCE_SESSIONS below ${MIN_BASELINE_SESSIONS_PERCENT}% of baseline $BASELINE_SESSIONS"
  if [[ -n "$reason" ]]; then
    set_incident_hold "$reason"
    fail "$reason; retention hold created"
  fi
}

validate_source() {
  if ! measure_source "${1:-$SOURCE}"; then
    set_incident_hold "$SOURCE_ERROR"
    fail "$SOURCE_ERROR; retention hold created"
  fi
  validate_against_baseline
}

stage_mcfly() {
  local live="$SOURCE/$MCFLY_DATABASE" recovery="$SOURCE/$MCFLY_RECOVERY_COPY"
  local tmp
  tmp=$(mktemp "$(dirname "$recovery")/.history.db.restic.XXXXXX")
  if ! sqlite3 "$live" <<SQL
.timeout 5000
.backup '$tmp'
SQL
  then
    rm -f "$tmp"
    fail "could not stage McFly database"
  fi
  if [[ $(sqlite3 "$tmp" 'PRAGMA integrity_check;') != ok ]]; then
    rm -f "$tmp"
    fail "staged McFly database integrity check failed"
  fi
  chown "$EXPECTED_UID:$EXPECTED_GID" "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$recovery"
  printf 'mcfly_staged path=%s\n' "$recovery"
}

repository_ready() {
  local actual_id
  actual_id=$(restic cat config | jq -er '.id') || return 1
  [[ $actual_id == "$EXPECTED_REPOSITORY_ID" ]] ||
    fail "repository identity mismatch: got $actual_id, expected $EXPECTED_REPOSITORY_ID"
}

require_maintenance_safe() {
  [[ ! -e "$INCIDENT_HOLD_FILE" ]] ||
    fail "retention is blocked by persistent incident hold: $INCIDENT_HOLD_FILE"
  validate_source "$SOURCE"
}

retention_args=(
  --host "$BACKUP_HOST"
  --path "$SOURCE"
  --keep-within 24h
  --keep-hourly 168
  --keep-daily 30
)

case "$COMMAND" in
  init)
    ensure_runtime
    acquire_lock
    start_log init
    validate_source "$SOURCE"
    repository_ready || fail "pinned repository is unavailable; init never creates or replaces it"
    printf 'repository_verified id=%s\n' "$EXPECTED_REPOSITORY_ID"
    ;;

  enroll-baseline)
    acquire_lock
    [[ ! -e "$SOURCE_BASELINE_FILE" ]] || fail "source baseline already exists: $SOURCE_BASELINE_FILE"
    measure_source "$SOURCE" || fail "$SOURCE_ERROR"
    install -d -m 700 "$(dirname "$SOURCE_BASELINE_FILE")"
    temporary=$(mktemp "${SOURCE_BASELINE_FILE}.tmp.XXXXXX")
    printf 'schema_version=1\nsource=%s\nbytes=%s\nfiles=%s\nsessions=%s\n' \
      "$SOURCE" "$SOURCE_BYTES" "$SOURCE_FILES" "$SOURCE_SESSIONS" > "$temporary"
    chmod 600 "$temporary"
    mv -f "$temporary" "$SOURCE_BASELINE_FILE"
    printf 'source_baseline_enrolled path=%s\n' "$SOURCE_BASELINE_FILE"
    ;;

  clear-hold)
    acquire_lock
    [[ -e "$INCIDENT_HOLD_FILE" ]] || fail "no incident hold exists: $INCIDENT_HOLD_FILE"
    measure_source "$SOURCE" || fail "$SOURCE_ERROR"
    validate_against_baseline
    rm -f "$INCIDENT_HOLD_FILE"
    printf 'incident_hold_cleared path=%s\n' "$INCIDENT_HOLD_FILE"
    ;;

  validate)
    acquire_lock
    validate_source "${2:-$SOURCE}"
    ;;

  backup)
    ensure_runtime
    acquire_lock
    start_log backup
    repository_ready || fail "repository is not initialized"
    validate_source "$SOURCE"
    stage_mcfly
    restic backup "$SOURCE" --one-file-system --host "$BACKUP_HOST" --tag automatic
    restic snapshots --host "$BACKUP_HOST" --path "$SOURCE" --latest 1
    printf 'completed=%s operation=backup\n' "$(date --iso-8601=seconds)"
    ;;

  retention)
    ensure_runtime
    acquire_lock
    start_log retention
    repository_ready || fail "repository is not initialized"
    require_maintenance_safe
    restic forget "${retention_args[@]}"
    printf 'completed=%s operation=retention\n' "$(date --iso-8601=seconds)"
    ;;

  prune)
    ensure_runtime
    acquire_lock
    start_log prune
    repository_ready || fail "repository is not initialized"
    require_maintenance_safe
    restic forget "${retention_args[@]}"
    restic prune
    printf 'completed=%s operation=prune\n' "$(date --iso-8601=seconds)"
    ;;

  check)
    ensure_runtime
    acquire_lock
    start_log check
    repository_ready || fail "repository is not initialized"
    restic check
    printf 'completed=%s operation=check\n' "$(date --iso-8601=seconds)"
    ;;

  check-read-data)
    ensure_runtime
    acquire_lock
    start_log check-read-data
    repository_ready || fail "repository is not initialized"
    restic check --read-data
    printf 'completed=%s operation=check-read-data\n' "$(date --iso-8601=seconds)"
    ;;

  snapshots)
    ensure_runtime
    repository_ready || fail "repository is not initialized"
    restic snapshots --host "$BACKUP_HOST" --path "$SOURCE"
    ;;

  status)
    ensure_runtime
    repository_ready || fail "repository is not initialized"
    # Restic returns the latest snapshot per host/path group. Compare actual
    # instants across groups, including timestamps with different UTC offsets.
    candidates=$(restic snapshots --host "$BACKUP_HOST" --path "$SOURCE" --latest 1 --json |
      jq -er '.[].time') || fail "repository has no readable matching snapshot timestamps"
    latest=''
    latest_epoch=0
    while IFS= read -r candidate; do
      candidate_epoch=$(date --date="$candidate" +%s) || fail "invalid snapshot timestamp"
      if [[ -z "$latest" ]] || ((candidate_epoch > latest_epoch)); then
        latest=$candidate
        latest_epoch=$candidate_epoch
      fi
    done <<< "$candidates"
    [[ -n "$latest" ]] || fail "repository has no matching snapshots"
    now_epoch=$(date +%s)
    age=$((now_epoch - latest_epoch))
    [[ $age -ge -300 ]] || fail "latest snapshot timestamp is unexpectedly in the future"
    (( age < 0 )) && age=0
    [[ $age -le $MAX_SNAPSHOT_AGE_SECONDS ]] || \
      fail "latest snapshot is stale: ${age}s exceeds ${MAX_SNAPSHOT_AGE_SECONDS}s"
    printf 'snapshot_status=healthy latest=%s age_seconds=%s maximum_seconds=%s\n' \
      "$latest" "$age" "$MAX_SNAPSHOT_AGE_SECONDS"
    ;;

  restore)
    ensure_runtime
    acquire_lock
    snapshot=${2:-latest}
    target=${3:-}
    [[ -n "$target" ]] || fail "usage: $0 restore SNAPSHOT TARGET"
    [[ "$target" == /var/tmp/* || "$target" == /home/* ]] || \
      fail "restore target must be under /var/tmp or /home"
    if [[ -e "$target" ]] && find "$target" -mindepth 1 -print -quit | grep -q .; then
      fail "restore target is not empty: $target"
    fi
    install -d -m 700 "$target"
    start_log restore
    repository_ready || fail "repository is not initialized"
    restic restore "$snapshot" --target "$target"
    printf 'completed=%s operation=restore snapshot=%s target=%s\n' \
      "$(date --iso-8601=seconds)" "$snapshot" "$target"
    ;;

  help|--help|-h)
    cat <<EOF
Usage: $0 COMMAND

Commands:
  init                         verify the existing pinned repository (no creation)
  enroll-baseline              record the initial healthy source baseline once
  clear-hold                   explicitly clear a hold after source recovery
  validate [SOURCE]            validate source and deletion baseline guards
  backup                       validate, stage McFly, and create a snapshot
  retention                    guarded retention without reclaiming packs
  prune                        guarded retention and reclaim unused packs
  check                        verify repository metadata and structure
  check-read-data              read and verify every repository data pack
  snapshots                    list snapshots for the configured host and path
  status                       fail if the latest snapshot is stale
  restore SNAPSHOT TARGET      restore into an empty staging directory
EOF
    ;;

  *)
    fail "unknown command: $COMMAND"
    ;;
esac
