#!/usr/bin/env bash
# Restic password-command provider. Its stdout is secret: invoke only from Restic.
set -euo pipefail
set +x
[[ $# -eq 0 ]] || { printf 'restic-home-password: arguments are not supported\n' >&2; exit 1; }
# Root runs only fixed system binaries as jack, never a user-owned shell helper.
if [[ $EUID -eq 0 ]]; then
  exec /usr/sbin/runuser -u jack -- /usr/bin/env -i \
    HOME=/home/jack GNUPGHOME=/home/jack/.gnupg PATH=/usr/bin:/bin \
    /usr/bin/gpg --batch --no-tty --pinentry-mode error --decrypt \
    /home/jack/.config/restic/home.password.gpg
fi
[[ $(/usr/bin/id -un) == jack ]] || { printf 'restic-home-password: expected root or jack\n' >&2; exit 1; }
exec /usr/bin/env -i HOME=/home/jack GNUPGHOME=/home/jack/.gnupg PATH=/usr/bin:/bin \
  /usr/bin/gpg --batch --no-tty --pinentry-mode error --decrypt \
  /home/jack/.config/restic/home.password.gpg
