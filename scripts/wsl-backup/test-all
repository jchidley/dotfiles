#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
LANE=${1:-fast}
[[ $# -le 1 ]] || { echo "Usage: $0 [fast|integration|all]" >&2; exit 2; }
case "$LANE" in fast|integration|all) ;; *) echo "Unknown test lane: $LANE" >&2; exit 2 ;; esac

require() { command -v "$1" >/dev/null 2>&1 || { echo "Required test tool is missing: $1" >&2; exit 1; }; }

WINDOWS_TEST_ROOT=''
cleanup_windows_tests() {
  if [[ -n $WINDOWS_TEST_ROOT ]]; then rm -rf -- "$WINDOWS_TEST_ROOT"; fi
}
stage_windows_tests() {
  local windows_temp windows_temp_linux
  windows_temp=$(pwsh.exe -NoLogo -NoProfile -NonInteractive -Command '[IO.Path]::GetTempPath()')
  windows_temp=${windows_temp//$'\r'/}
  [[ -n $windows_temp ]] || { echo 'Windows TEMP path is empty' >&2; exit 1; }
  windows_temp_linux=$(wslpath -u "$windows_temp")
  WINDOWS_TEST_ROOT=$(mktemp -d -- "${windows_temp_linux%/}/wsl-backup-fast.XXXXXX")
  cp -a -- "$ROOT/." "$WINDOWS_TEST_ROOT/"
  trap cleanup_windows_tests EXIT
}
run_windows_test() {
  local relative path
  relative=${1#"$ROOT"/}
  [[ $relative != "$1" ]] || { echo "Windows test is outside test root: $1" >&2; exit 1; }
  path=$(wslpath -w "$WINDOWS_TEST_ROOT/$relative")
  printf 'test_start file=%s\n' "$path"
  # RemoteSigned treats WSL's UNC path as remote. Run the unchanged fixture copy
  # from local Windows TEMP instead of weakening or bypassing execution policy.
  pwsh.exe -NoLogo -NoProfile -NonInteractive -File "$path" </dev/null
  printf 'test_pass file=%s\n' "$path"
}

run_fast() {
  require bash
  require shellcheck
  require pwsh.exe
  require wslpath

  local shell_files=(
    "$ROOT/setup.sh" "$ROOT/test-all" "$ROOT/wsl-backup"
    "$ROOT/home/backup-wsl-home" "$ROOT/home/wsl-home-scheduler"
    "$ROOT/home/test-restic-recovery-password" "$ROOT/home/test-recovery-password.sh"
    "$ROOT/home/restic-home-password" "$ROOT/home/prepare-gpg-credential"
    "$ROOT/system/test-gpg-password-command.sh"
    "$ROOT/system/capture-offline-system" "$ROOT/system/test-offline-system.sh"
    "$ROOT/system/test-restore-validator.sh"
    "$ROOT/home/migrate-linux-scheduler.sh"
    "$ROOT/home/install.sh" "$ROOT/home/test.sh" "$ROOT/home/test-scheduler.sh"
    "$ROOT/home/test-scheduler-mutations.sh"
    "$ROOT/system/install.sh" "$ROOT/system/validate-wsl-system-restore"
    "$ROOT/system/copy-combined-home-snapshot" "$ROOT/system/capture-combined-system"
    "$ROOT/system/test-combined-home-copy.sh" "$ROOT/system/test-combined-system.sh"
    "$ROOT/tests/test-setup-and-cli.sh"
  )
  bash -n "${shell_files[@]}"
  shellcheck "${shell_files[@]}"
  "$ROOT/tests/test-setup-and-cli.sh"
  "$ROOT/home/test-scheduler.sh"
  "$ROOT/home/test-scheduler-mutations.sh"
  stage_windows_tests
  run_windows_test "$ROOT/tests/Test-TestProcess.ps1"
  run_windows_test "$ROOT/home/Test-WslHomeWindows.ps1"
  run_windows_test "$ROOT/home/Test-WslHomeSchedulingShadow.ps1"
  run_windows_test "$ROOT/home/Test-WslHomeSchedulingStateAdapter.ps1"
  run_windows_test "$ROOT/home/Test-WslHomeSchedulingStateAdapterMutations.ps1"
  run_windows_test "$ROOT/home/Test-WslHomeLongJobConsent.ps1"
  run_windows_test "$ROOT/home/Test-WslHomeLongJobConsentMutations.ps1"
  run_windows_test "$ROOT/home/Test-WslHomeSchedulingMigration.ps1"
  run_windows_test "$ROOT/home/Test-WslHomeSchedulingMigrationMutations.ps1"
  run_windows_test "$ROOT/system/Test-WslSystemBackup.ps1"

  local ps_lint='' ps_exec=''
  local candidate="$HOME/git/agent-skills/skills/windows-env/ps-lint"
  ps_exec="$(dirname "$candidate")/ps-exec"
  if [[ -f "$candidate" && -f "$ps_exec" ]] && grep -q 'pwsh\.exe' "$ps_exec"; then
    ps_lint=$candidate
  fi
  if [[ -n "$ps_lint" ]]; then
    local ps_files=()
    while IFS= read -r -d '' path; do ps_files+=("$path"); done < <(
      find "$ROOT" -type f -name '*.ps1' -print0
    )
    local lint_wslenv='PS_LINT_PATHS:PS_LINT_SETTINGS:PS_LINT_INSTALLER:PS_LINT_VERSION:PS_LINT_CACHE_ROOT:PS_LINT_OFFLINE'
    if [[ -n ${WSLENV:-} ]]; then lint_wslenv="$WSLENV:$lint_wslenv"; fi
    WSLENV=$lint_wslenv bash "$ps_lint" --offline --settings "$ROOT/PSScriptAnalyzerSettings.psd1" "${ps_files[@]}"
  else
    echo 'WARNING: windows-env ps-lint not found; PowerShell static analysis skipped' >&2
  fi
  echo 'WSL backup fast test lane passed.'
}

run_integration() {
  require restic
  bash "$ROOT/system/test-combined-home-copy.sh"
  bash "$ROOT/system/test-combined-system.sh"
  require sudo
  bash "$ROOT/system/test-gpg-password-command.sh"
  sudo bash "$ROOT/system/test-offline-system.sh"
  sudo bash "$ROOT/system/test-restore-validator.sh"
  sudo bash "$ROOT/home/test-recovery-password.sh"
  sudo "$ROOT/home/test.sh"
  if command -v wsl-backup >/dev/null 2>&1; then
    wsl-backup status
  else
    echo 'WARNING: installed wsl-backup command absent; production status smoke test skipped' >&2
  fi
  echo 'WSL backup integration test lane passed.'
}

case "$LANE" in
  fast) run_fast ;;
  integration) run_integration ;;
  all) run_fast; run_integration ;;
esac
