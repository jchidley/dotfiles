#!/usr/bin/env bash
set -euo pipefail

HOME_COMMAND=${WSL_BACKUP_HOME_COMMAND:-/usr/local/sbin/backup-wsl-home}
SUDO_COMMAND=${WSL_BACKUP_SUDO:-sudo}
POWERSHELL=${WSL_BACKUP_POWERSHELL:-pwsh.exe}
SYSTEM_SCRIPT_CONFIG=${WSL_BACKUP_SYSTEM_SCRIPT_CONFIG:-/etc/wsl-backup/windows-system-script}

usage() {
  cat <<'EOF'
Usage:
  wsl-backup status
  wsl-backup home <backup|snapshots|status|retention|prune|check|check-read-data|restore> [args...]
  wsl-backup system <Preflight|Status|Export|Validate|Recover|ValidateManifest|Cleanup> [PowerShell options...]

Examples:
  wsl-backup status
  wsl-backup home snapshots
  wsl-backup system Preflight
  wsl-backup system Export -ConfirmMaintenanceWindow

System Export stops the source distro and requires the explicit maintenance
window switch. Restore always targets an empty ext4 staging directory.
EOF
}

run_home() {
  if ((EUID == 0)); then
    "$HOME_COMMAND" "$@"
  else
    "$SUDO_COMMAND" "$HOME_COMMAND" "$@"
  fi
}

system_script() {
  local config=$SYSTEM_SCRIPT_CONFIG
  [[ -r "$config" ]] || {
    echo "Windows controller is not installed; rerun scripts/wsl-backup/setup.sh" >&2
    return 1
  }
  local path
  IFS= read -r path < "$config"
  [[ -n "$path" ]] || { echo "Windows controller path is empty" >&2; return 1; }
  printf '%s\n' "$path"
}

run_system() {
  if [[ "$POWERSHELL" == */* ]]; then
    [[ -x "$POWERSHELL" ]] || { echo "$POWERSHELL is unavailable" >&2; return 1; }
  else
    command -v "$POWERSHELL" >/dev/null 2>&1 || { echo "$POWERSHELL is unavailable" >&2; return 1; }
  fi
  local script
  script=$(system_script)
  # Windows-native PowerShell writes CRLF even when called through WSL.
  # Normalize stdout at this boundary while pipefail preserves PowerShell failures.
  "$POWERSHELL" -NoLogo -NoProfile -NonInteractive -File "$script" "$@" </dev/null \
    2> >(sed 's/\r$//' >&2) |
    sed 's/\r$//'
}

command=${1:-help}
case "$command" in
  status)
    echo '== Home snapshots =='
    run_home status
    echo
    echo '== Whole-system exports =='
    run_system -Mode Status
    ;;
  home)
    (($# >= 2)) || { usage >&2; exit 2; }
    shift
    run_home "$@"
    ;;
  system)
    (($# >= 2)) || { usage >&2; exit 2; }
    mode=$2
    shift 2
    run_system -Mode "$mode" "$@"
    ;;
  help|-h|--help) usage ;;
  *) echo "Unknown command: $command" >&2; usage >&2; exit 2 ;;
esac
