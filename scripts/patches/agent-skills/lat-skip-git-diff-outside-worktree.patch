diff --git a/extensions/lat/policy.ts b/extensions/lat/policy.ts
index 5a6fbb5..03a3f4f 100644
--- a/extensions/lat/policy.ts
+++ b/extensions/lat/policy.ts
@@ -1,3 +1,17 @@
+import { execFileSync } from "node:child_process";
+
+export function isInsideGitWorkTree(cwd: string): boolean {
+  try {
+    return execFileSync("git", ["rev-parse", "--is-inside-work-tree"], {
+      cwd,
+      encoding: "utf8",
+      stdio: ["ignore", "pipe", "pipe"],
+    }).trim() === "true";
+  } catch {
+    return false;
+  }
+}
+
 export function shouldValidateLat(beforeRelevantDiff: string, afterRelevantDiff: string): boolean {
   return beforeRelevantDiff !== afterRelevantDiff;
 }
