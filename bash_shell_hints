# Quick hints

# Search/history
rg <pattern> <path>              # fast search
fd <name>                        # fast find
history                         # show shell history (McFly normally saves it automatically)
Ctrl-R                          # McFly history search
history -a                      # manually flush current shell history when needed
!<num>                          # rerun history entry by number

# Secrets (GPG/ak)
ak list                          # show configured services + status
ak get <service>                 # decrypt one secret; capture inside the consuming command, not agent output
~/.envrc                         # reviewed allowlist; direnv loads these services on entering the directory
direnv reload                    # refresh exports after changing the vault or profile
gpgconf --kill gpg-agent         # lock GPG cache immediately (default TTL: 20h)
credential-reset                # visible WSL terminal: start fresh GPG + SSH window (prompts again)
ssh-add -l                       # check SSH identities when needed (default TTL: 20h)

# WSL/Windows helpers
wslpath "C:\Users\jackc\Downloads"  # Windows path -> WSL path
# Optional shell aliases: clipcopy, clippaste, snip, shot, screenshot

# tmux helpers (optional)
t                               # new isolated socketed session
tmux ls                         # default socket only; does not list sessions created by t
tclean                          # cleanup unattached t sessions
